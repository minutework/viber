{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viber.minutework.ai/schema/profile.schema.json",
  "title": "Verifiable AI-Builder Profile",
  "description": "The ONLY payload submitted to public-dj. HARD ALLOWLIST: additionalProperties is false at every level, every string is length/enum/pattern bounded, opaque ids are hex-only, and no field is named for a path, filename, author email/name, raw code, or secret. STRUCTURAL guarantees are: (i) closed objects (no extra fields), (ii) type/length/enum/pattern bounds, (iii) hex-only opaque ids that cannot encode a path/identifier/email/repo-or-org name. PII exclusion WITHIN allowed free-text fields (e.g. rationale, excerpt, summary) is NOT provided by length bounds; it is enforced by the two redaction layers + public-dj's independent re-scrub-and-REJECT. It is the 1:1 mirror of docs/data-handling.md, enforced fail-closed by BOTH the client Validator and public-dj ingestion. Raw transcripts and source code are NEVER part of this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_version",
    "handle",
    "generated_at",
    "agent",
    "analysis_manifest",
    "dimensions",
    "archetype",
    "overall_grade",
    "overall_score",
    "overall_summary",
    "top_strengths",
    "growth_edges",
    "episode_scores",
    "redaction_report"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this schema the payload was built against. Frozen per release.",
      "const": "1.1.0"
    },
    "rubric_version": {
      "description": "Version of skill/rubric.md used to score. Decoupled from the schema pin as of 1.1.0: the allowed pairings (1.1.0 schema accepts rubric 1.0.0 or 1.1.0) are enforced by a server-side compatibility map in public-dj schema_validation, not by this const.",
      "enum": ["1.0.0", "1.1.0"]
    },
    "handle": {
      "description": "Lowercased GitHub username. The ONLY identity field. Comes from the verified submission token's claims, never from transcript text. public-dj overwrites/validates this against the token on ingestion.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$",
      "maxLength": 39
    },
    "generated_at": {
      "description": "UTC ISO-8601 timestamp when the profile was synthesized.",
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "description": "Which coding agent performed the local analysis. No version path or install location.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": { "enum": ["claude", "codex", "cursor"] },
        "tool_version": {
          "description": "Reported agent CLI version string only (e.g. '1.2.3'). Pattern excludes '/', whitespace, and '@' so no path/host can hide here.",
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,39}$"
        },
        "parallelism": {
          "description": "Whether the run used true subagent parallelism or a sequential-shard fallback.",
          "enum": ["parallel", "sequential"]
        }
      }
    },
    "analysis_manifest": {
      "description": "Aggregate run statistics. Counts and windows only; nothing identifying.",
      "type": "object",
      "additionalProperties": false,
      "required": ["session_count", "episode_count", "project_scope"],
      "properties": {
        "session_count": { "type": "integer", "minimum": 0 },
        "episode_count": { "type": "integer", "minimum": 0 },
        "scored_episode_count": { "type": "integer", "minimum": 0 },
        "total_tokens_estimate": { "type": "integer", "minimum": 0 },
        "analyzed_token_estimate": { "type": "integer", "minimum": 0 },
        "time_window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "first_activity_at": { "type": "string", "format": "date-time" },
            "last_activity_at": { "type": "string", "format": "date-time" },
            "active_days": { "type": "integer", "minimum": 0 }
          }
        },
        "project_scope": {
          "description": "Confirmation the analysis was scoped to a single chosen project. NEVER a name, path, or remote URL — only the assertion and a count of repos considered (must be 1).",
          "type": "object",
          "additionalProperties": false,
          "required": ["single_project", "repos_considered"],
          "properties": {
            "single_project": { "const": true },
            "repos_considered": { "const": 1 }
          }
        }
      }
    },
    "dimensions": {
      "description": "The eight competency dimensions. A dimension key is OMITTED entirely when there is no direct evidence (omission != low score). Every present dimension MUST carry >=2 cited, redacted evidence excerpts. These scores are RECOMPUTED server-side by public-dj from the verified per-episode scores (rubric.md §4); client-submitted values are advisory display hints only and are overwritten on ingestion.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "architecture": { "$ref": "#/$defs/dimensionScore" },
        "decomposition": { "$ref": "#/$defs/dimensionScore" },
        "steering": { "$ref": "#/$defs/dimensionScore" },
        "debugging": { "$ref": "#/$defs/dimensionScore" },
        "code_review": { "$ref": "#/$defs/dimensionScore" },
        "velocity": { "$ref": "#/$defs/dimensionScore" },
        "product": { "$ref": "#/$defs/dimensionScore" },
        "communication": { "$ref": "#/$defs/dimensionScore" }
      }
    },
    "archetype": {
      "description": "Short builder archetype label (e.g. 'Systems Architect', 'Rapid Prototyper'). Generated narrative; re-scrubbed.",
      "type": "string",
      "maxLength": 60
    },
    "overall_grade": {
      "enum": ["exceptional", "strong", "proficient", "developing", "emerging"]
    },
    "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "overall_summary": {
      "description": "Scrubbed narrative summary. LLM-generated text is re-run through both redaction layers before it lands here.",
      "type": "string",
      "maxLength": 2000
    },
    "top_strengths": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 160 }
    },
    "growth_edges": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "maxLength": 160 }
    },
    "episode_scores": {
      "description": "Per-episode scoring records; the unit of analysis is the EPISODE, not the session. An episode can only be listed if the public-dj scoring proxy scored it and returned a nonce (nonce is required), so unscored episodes are simply ABSENT rather than submitted unverified. On ingestion public-dj recomputes each nonce; an episode whose nonce FAILS verification is stored held (verified=false). public-dj also requires the submitted set to cover EVERY request_id the proxy issued for this submission token (blocks dropping low-scoring episodes), and RECOMPUTES all aggregate scores (dimensions.*, overall_*) from the verified per-episode scores per rubric.md §4.",
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/episodeScore" }
    },
    "session_metadata": {
      "description": "Per-session aggregate metadata. session_ref is an opaque, locally-salted hash, never the real session id or any path.",
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/sessionMetadata" }
    },
    "git_metrics": {
      "description": "Aggregate git statistics derived host-side. NO per-file paths, NO filenames, NO author name, NO author email. File involvement expressed only as counts and extension histograms.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit_count": { "type": "integer", "minimum": 0 },
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_deleted": { "type": "integer", "minimum": 0 },
        "vibe_loc_by_period": {
          "description": "Lines-added breakdown for profile display. UTC calendar buckets only; no paths, filenames, commit hashes, author data, or repo identifiers.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "today": { "type": "integer", "minimum": 0 },
            "this_week": { "type": "integer", "minimum": 0 },
            "this_month": { "type": "integer", "minimum": 0 },
            "this_year": { "type": "integer", "minimum": 0 }
          }
        },
        "files_changed_count": { "type": "integer", "minimum": 0 },
        "active_days": { "type": "integer", "minimum": 0 },
        "commits_per_active_day": { "type": "number", "minimum": 0 },
        "extension_histogram": {
          "description": "Map of file EXTENSION (no dot, no path) -> change count. Extensions only; e.g. {\"ts\": 40, \"py\": 12}. Keys validated against a safe pattern.",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9]{1,12}$": { "type": "integer", "minimum": 0 }
          }
        },
        "velocity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "median_commit_gap_minutes": { "type": "number", "minimum": 0 },
            "busiest_hour_utc": { "type": "integer", "minimum": 0, "maximum": 23 },
            "weekend_share": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "commit_hour_histogram_local": { "$ref": "#/$defs/hourHistogram24" },
        "commits_by_weekday_local": { "$ref": "#/$defs/weekdayHistogram7" },
        "loc_added_by_weekday_local": { "$ref": "#/$defs/weekdayHistogram7" },
        "night_owl_share": {
          "description": "Share of author-filtered commits landing 22:00-02:00 in the author's LOCAL clock (derived from %cI offsets; no timezone name is ever shipped).",
          "$ref": "#/$defs/share01"
        },
        "biggest_push": {
          "description": "The single biggest calendar day by lines added. WEEKDAY ONLY — the exact date would be cross-referenceable against public repo activity given the handle.",
          "type": "object",
          "additionalProperties": false,
          "required": ["weekday_local", "commit_count", "lines_added"],
          "properties": {
            "weekday_local": { "type": "integer", "minimum": 0, "maximum": 6 },
            "commit_count": { "type": "integer", "minimum": 0 },
            "lines_added": { "type": "integer", "minimum": 0 }
          }
        },
        "pr_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["merged_pr_count_30d", "source"],
          "properties": {
            "merged_pr_count_30d": { "type": "integer", "minimum": 0 },
            "source": { "enum": ["merge_commit_heuristic", "gh_cli"] }
          }
        },
        "last_30_days": {
          "description": "Rolling trailing-30-day window (author-filtered), unlike the calendar buckets in vibe_loc_by_period.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit_count": { "type": "integer", "minimum": 0 },
            "lines_added": { "type": "integer", "minimum": 0 },
            "lines_deleted": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "vibe_metrics": {
      "description": "Uncapped aggregate-only local metrics for public profile display. Counts, hours, provider-token totals, source status, and coverage only; no raw transcripts, paths, filenames, ids, commit hashes, authors, or code.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics_scope": { "const": "all_project_sessions_uncapped" },
        "total_vibe_agent_hours": { "type": "number", "minimum": 0 },
        "total_active_calendar_hours": { "type": "number", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "token_sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": { "$ref": "#/$defs/tokenSource" },
            "codex": { "$ref": "#/$defs/tokenSource" },
            "cursor": { "$ref": "#/$defs/tokenSource" }
          }
        },
        "vibe_agent_hours_by_period": {
          "description": "Summed agent-hours by UTC calendar bucket. Derived from timestamped local activity intervals only.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "today": { "type": "number", "minimum": 0 },
            "this_week": { "type": "number", "minimum": 0 },
            "this_month": { "type": "number", "minimum": 0 },
            "this_year": { "type": "number", "minimum": 0 }
          }
        },
        "active_calendar_hours_by_period": {
          "description": "De-duplicated active calendar hours by UTC calendar bucket.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "today": { "type": "number", "minimum": 0 },
            "this_week": { "type": "number", "minimum": 0 },
            "this_month": { "type": "number", "minimum": 0 },
            "this_year": { "type": "number", "minimum": 0 }
          }
        },
        "provider_tokens_by_period": {
          "description": "Provider-reported token totals by UTC calendar bucket. Estimates are excluded.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "today": { "type": "integer", "minimum": 0 },
            "this_week": { "type": "integer", "minimum": 0 },
            "this_month": { "type": "integer", "minimum": 0 },
            "this_year": { "type": "integer", "minimum": 0 }
          }
        },
        "total_vibe_loc": { "type": "integer", "minimum": 0 },
        "vibe_loc_by_period": {
          "description": "Lines-added breakdown for profile display. UTC calendar buckets only; no paths, filenames, commit hashes, author data, or repo identifiers.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "today": { "type": "integer", "minimum": 0 },
            "this_week": { "type": "integer", "minimum": 0 },
            "this_month": { "type": "integer", "minimum": 0 },
            "this_year": { "type": "integer", "minimum": 0 }
          }
        },
        "metrics_coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claude": { "$ref": "#/$defs/metricsToolCoverage" },
                "codex": { "$ref": "#/$defs/metricsToolCoverage" },
                "cursor": { "$ref": "#/$defs/metricsToolCoverage" }
              }
            },
            "totals": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "session_count": { "type": "integer", "minimum": 0 },
                "timestamped_event_count": { "type": "integer", "minimum": 0 },
                "active_days": { "type": "integer", "minimum": 0 },
                "first_activity_at": { "type": "string", "format": "date-time" },
                "last_activity_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9_.:-]{1,120}$" }
        },
        "model_usage": {
          "description": "Per model-family usage split. Families come from a fixed client-side allowlist map (fail-closed); raw ids that do not normalize are dropped, so free text can never ride along.",
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_family", "tool", "session_count"],
            "properties": {
              "model_family": { "type": "string", "maxLength": 40, "pattern": "^[0-9A-Za-z][0-9A-Za-z .()+-]{0,39}$" },
              "tool": { "enum": ["claude", "codex", "cursor"] },
              "session_count": { "type": "integer", "minimum": 0 },
              "session_share_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "token_share_pct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "plan_mode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_prompts_share": { "$ref": "#/$defs/share01" },
            "sessions_entering_plan_share": { "$ref": "#/$defs/share01" },
            "plan_before_first_edit_share": { "$ref": "#/$defs/share01" },
            "plan_approved_count": { "type": "integer", "minimum": 0 },
            "plan_edited_before_approval_count": { "type": "integer", "minimum": 0 },
            "per_tool": { "$ref": "#/$defs/perToolShare" }
          }
        },
        "interruption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interrupt_count": { "type": "integer", "minimum": 0 },
            "interrupts_per_100_prompts": { "type": "number", "minimum": 0 },
            "redirected_share": { "$ref": "#/$defs/share01" },
            "abandoned_share": { "$ref": "#/$defs/share01" },
            "median_rebrief_seconds": { "type": "number", "minimum": 0 },
            "per_tool": { "$ref": "#/$defs/perToolCount" }
          }
        },
        "concurrency": {
          "description": "Sweep-line maxima over active intervals. peak_at is hour-truncated. Repo identities never appear — only counts.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_parallel_agents": { "type": "integer", "minimum": 0 },
            "max_parallel_sessions": { "type": "integer", "minimum": 0 },
            "max_parallel_subagents_single_session": { "type": "integer", "minimum": 0 },
            "peak_at": { "type": "string", "format": "date-time" },
            "by_tool": { "$ref": "#/$defs/perToolCount" }
          }
        },
        "prompt_stats": {
          "description": "Numeric-only prompt analytics over HUMAN prompts (tool results, sidechains, SDK prompts, command wrappers, and queued duplicates excluded). No prompt text ships in this block.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_count": { "type": "integer", "minimum": 0 },
            "median_words": { "type": "number", "minimum": 0 },
            "under_10_words_share": { "$ref": "#/$defs/share01" },
            "words_histogram": {
              "description": "Fixed buckets: <5, 5-9, 10-24, 25-49, 50-99, >=100 words.",
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "type": "integer", "minimum": 0 }
            },
            "politeness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "thanks_message_count": { "type": "integer", "minimum": 0 },
                "please_message_count": { "type": "integer", "minimum": 0 },
                "last_30_days_thanks_message_count": { "type": "integer", "minimum": 0 }
              }
            },
            "crashout_message_count": { "type": "integer", "minimum": 0 },
            "question_share": { "$ref": "#/$defs/share01" },
            "opener_split": {
              "description": "How sessions open, as shares of first human prompts.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": { "$ref": "#/$defs/share01" },
                "question": { "$ref": "#/$defs/share01" },
                "greeting": { "$ref": "#/$defs/share01" },
                "other": { "$ref": "#/$defs/share01" }
              }
            }
          }
        },
        "event_hour_histogram_local": { "$ref": "#/$defs/hourHistogram24" },
        "longest_agent_run": {
          "description": "Longest autonomous run between human inputs. The label is the episode-type enum only — no free text.",
          "type": "object",
          "additionalProperties": false,
          "required": ["minutes", "agent_type"],
          "properties": {
            "minutes": { "type": "number", "minimum": 0 },
            "agent_type": { "enum": ["claude", "codex", "cursor"] },
            "intent": { "enum": ["feature", "bugfix", "refactor", "investigation", "infra", "review", "planning", "other"] },
            "session_ref": { "$ref": "#/$defs/opaqueRef" }
          }
        },
        "last_30_days": {
          "description": "Rolling trailing-30-day window, unlike the calendar period buckets.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vibe_agent_hours": { "type": "number", "minimum": 0 },
            "active_calendar_hours": { "type": "number", "minimum": 0 },
            "provider_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "recent_commits": {
      "description": "Scrubbed commit subjects with timestamps ONLY. No author name, no author email, and NO commit hash (a real short hash is cross-referenceable against the public repo and would deanonymize the user/repo/author given the handle). Subjects pass both redaction layers.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "authored_at"],
        "properties": {
          "subject": { "type": "string", "maxLength": 200 },
          "authored_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "decisions": {
      "description": "Notable steering/architecture decisions, fully redacted. proposal/response are paraphrased and scrubbed — never raw transcript or code.",
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/decision" }
    },
    "code_quality": {
      "description": "Aggregate code-quality signals inferred from behavior. Booleans and counts only; never code.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_written_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviews_ai_output_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "refactor_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "blind_accept_signal": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string", "maxLength": 600 }
      }
    },
    "work_streams": {
      "description": "Multi-session work streams grouped by salted branch ref + overlapping time windows, with commits attached by time+branch match. Counts and durations only; no titles, branch names, or paths.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream_ref", "session_count"],
        "properties": {
          "stream_ref": { "$ref": "#/$defs/opaqueRef" },
          "session_count": { "type": "integer", "minimum": 1 },
          "active_days": { "type": "integer", "minimum": 0 },
          "total_active_minutes": { "type": "number", "minimum": 0 },
          "commit_count": { "type": "integer", "minimum": 0 },
          "lines_added": { "type": "integer", "minimum": 0 },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "craft_stats": {
      "description": "Deterministic engineering-craft aggregates. All shares are 0-1; the command classifier behind the *_rate fields is versioned in client_telemetry.classifier_version.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edit_precision_rate": { "$ref": "#/$defs/share01" },
        "edit_attempt_count": { "type": "integer", "minimum": 0 },
        "red_to_green_median_minutes": { "type": "number", "minimum": 0 },
        "red_to_green_sample_count": { "type": "integer", "minimum": 0 },
        "tool_error_recovery_rate": { "$ref": "#/$defs/share01" },
        "test_before_ship_rate": { "$ref": "#/$defs/share01" },
        "plan_to_ship_conversion": { "$ref": "#/$defs/share01" },
        "median_blast_radius_files": { "type": "number", "minimum": 0 },
        "p90_blast_radius_files": { "type": "number", "minimum": 0 },
        "refactor_to_greenfield_ratio": { "$ref": "#/$defs/share01" },
        "rework_rate_48h": { "$ref": "#/$defs/share01" },
        "pr_routed_share": { "$ref": "#/$defs/share01" },
        "context_craft_edit_count": {
          "description": "Edits to agent-context files (CLAUDE.md, AGENTS.md, SKILL.md, rules dirs) matched against a fixed basename allowlist; paths never ship.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "economics_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache_hit_rate": { "$ref": "#/$defs/share01" },
        "loc_per_million_tokens": { "type": "number", "minimum": 0 },
        "churn_ratio": { "type": "number", "minimum": 0 },
        "idea_to_commit_median_minutes": { "type": "number", "minimum": 0 },
        "idea_to_commit_sample_count": { "type": "integer", "minimum": 0 },
        "peak_ship_week": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lines_added": { "type": "integer", "minimum": 0 },
            "commit_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "orchestration_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidechain_output_share": { "$ref": "#/$defs/share01" },
        "deepest_delegation_chain": { "type": "integer", "minimum": 0, "maximum": 16 },
        "subagent_count": { "type": "integer", "minimum": 0 },
        "subagent_session_count": { "type": "integer", "minimum": 0 },
        "cross_tool_spawn_share": {
          "description": "Share of Codex sessions whose originator is another agent tool rather than the human's CLI.",
          "$ref": "#/$defs/share01"
        },
        "autonomy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codex_never_approval_share": { "$ref": "#/$defs/share01" },
            "claude_auto_share": { "$ref": "#/$defs/share01" },
            "claude_accept_edits_share": { "$ref": "#/$defs/share01" }
          }
        },
        "checklist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "todo_item_count": { "type": "integer", "minimum": 0 },
            "update_plan_count": { "type": "integer", "minimum": 0 }
          }
        },
        "ask_user_question": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "question_count": { "type": "integer", "minimum": 0 },
            "answered_share": { "$ref": "#/$defs/share01" },
            "median_reply_seconds": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "identity_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "longest_build_streak_days": { "type": "integer", "minimum": 0 },
        "current_streak_days": { "type": "integer", "minimum": 0 },
        "first_contact": {
          "description": "Earliest corroborated agent activity. Requires >=2 sources active within 30 days of the claimed origin (anti-backdating).",
          "type": "object",
          "additionalProperties": false,
          "required": ["first_activity_at", "corroborating_sources"],
          "properties": {
            "first_activity_at": { "type": "string", "format": "date-time" },
            "corroborating_sources": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        },
        "tool_loyalty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary_tool": { "enum": ["claude", "codex", "cursor"] },
            "primary_tool_active_day_share": { "$ref": "#/$defs/share01" },
            "all_three_tools_day_count": { "type": "integer", "minimum": 0 }
          }
        },
        "session_shape": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": { "enum": ["sprinter", "marathoner", "mixed"] },
            "median_session_minutes": { "type": "number", "minimum": 0 },
            "over_two_hours_share": { "$ref": "#/$defs/share01" }
          }
        }
      }
    },
    "operating_level": {
      "description": "Evidence-anchored operating band (rubric 1.1). NEVER a job title. Stored on ingest but served by public-dj only for maturity-established profiles with sufficient episode counts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "confidence", "evidence"],
      "properties": {
        "band": { "enum": ["feature_executor", "system_designer", "platform_shaper"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidenceExcerpt" }
        }
      }
    },
    "specialty_signals": {
      "description": "Topic-tagged sub-scores: architecture-dimension evidence filtered to a fixed topic taxonomy. Omit a topic with no evidence.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "scalability": { "$ref": "#/$defs/specialtyScore" },
        "security": { "$ref": "#/$defs/specialtyScore" },
        "data_modeling": { "$ref": "#/$defs/specialtyScore" },
        "distributed_systems": { "$ref": "#/$defs/specialtyScore" },
        "performance": { "$ref": "#/$defs/specialtyScore" },
        "ux": { "$ref": "#/$defs/specialtyScore" },
        "tooling": { "$ref": "#/$defs/specialtyScore" }
      }
    },
    "client_telemetry": {
      "description": "Non-identifying client run telemetry. OS FAMILY only (darwin/linux/win), never hostname/username/path.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os_family": { "enum": ["darwin", "linux", "windows", "unknown"] },
        "run_duration_ms": { "type": "integer", "minimum": 0 },
        "skill_version": { "type": "string", "maxLength": 40, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,39}$" },
        "mcp_version": { "type": "string", "maxLength": 40, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,39}$" },
        "classifier_version": { "type": "string", "maxLength": 40, "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,39}$" }
      }
    },
    "redaction_report": {
      "description": "Client self-attestation that both redaction layers ran fail-closed. ADVISORY/telemetry only: public-dj independently re-runs BOTH redactors over EVERY text field regardless of these counts and REJECTS the whole submission on any hit. Both layer booleans must be true (a single layer is not acceptable).",
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_scrubber_applied", "code_path_identifier_redactor_applied", "fail_closed"],
      "properties": {
        "secret_scrubber_applied": { "const": true },
        "code_path_identifier_redactor_applied": { "const": true },
        "fail_closed": { "const": true },
        "secrets_scrubbed_count": { "type": "integer", "minimum": 0 },
        "paths_scrubbed_count": { "type": "integer", "minimum": 0 },
        "identifiers_scrubbed_count": { "type": "integer", "minimum": 0 },
        "fields_dropped_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "tokenSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["provider_reported", "estimated", "unavailable"] },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9_.:-]{1,120}$" }
        }
      }
    },
    "metricsToolCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "session_count", "timestamped_event_count", "active_hours", "active_days", "token_source", "warnings"],
      "properties": {
        "tool": { "enum": ["claude", "codex", "cursor"] },
        "session_count": { "type": "integer", "minimum": 0 },
        "timestamped_event_count": { "type": "integer", "minimum": 0 },
        "active_hours": { "type": "number", "minimum": 0 },
        "active_days": { "type": "integer", "minimum": 0 },
        "first_activity_at": { "type": "string", "format": "date-time" },
        "last_activity_at": { "type": "string", "format": "date-time" },
        "token_source": { "enum": ["provider_reported", "estimated", "unavailable"] },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9_.:-]{1,120}$" }
        }
      }
    },
    "dimensionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "rationale", "evidence"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": {
          "description": "Scrubbed rationale for the score. Re-run through both redaction layers.",
          "type": "string",
          "maxLength": 800
        },
        "evidence": {
          "description": "2-3 cited, redacted excerpts proving the score. No evidence => the dimension must be omitted, not scored.",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/evidenceExcerpt" }
        }
      }
    },
    "evidenceExcerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "excerpt", "why"],
      "properties": {
        "episode_id": { "$ref": "#/$defs/episodeId" },
        "excerpt": {
          "description": "A short, paraphrased-and-scrubbed quote illustrating the behavior. NEVER raw code, paths, identifiers, or secrets. Passes both redaction layers.",
          "type": "string",
          "maxLength": 400
        },
        "why": {
          "description": "One line: why this excerpt supports the score.",
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "episodeScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "type", "scores", "confidence", "nonce"],
      "properties": {
        "episode_id": { "$ref": "#/$defs/episodeId" },
        "title": {
          "description": "Scrubbed episode title/intent.",
          "type": "string",
          "maxLength": 200
        },
        "type": {
          "enum": ["feature", "bugfix", "refactor", "investigation", "infra", "review", "planning", "other"]
        },
        "scores": {
          "description": "Per-dimension mini-scores for this episode. Only dimensions with evidence in this episode appear.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "architecture": { "$ref": "#/$defs/score0to100" },
            "decomposition": { "$ref": "#/$defs/score0to100" },
            "steering": { "$ref": "#/$defs/score0to100" },
            "debugging": { "$ref": "#/$defs/score0to100" },
            "code_review": { "$ref": "#/$defs/score0to100" },
            "velocity": { "$ref": "#/$defs/score0to100" },
            "product": { "$ref": "#/$defs/score0to100" },
            "communication": { "$ref": "#/$defs/score0to100" }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "session_refs": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/opaqueRef" }
        },
        "nonce": { "$ref": "#/$defs/scoringNonce" }
      }
    },
    "scoringNonce": {
      "description": "Proxy-issued, tamper-evident integrity token; the public-dj scoring proxy returns one per episode it scores. FROZEN CANONICAL PREIMAGE: signature = base64url(HMAC-SHA256(server_key, request_id + '\\n' + handle + '\\n' + digest + '\\n' + canonical_scores)), where digest = base64url(SHA-256(JCS({episode_id, type, scores}))), JCS = RFC 8785 canonical JSON (sorted keys, no whitespace), canonical_scores = JCS of the scores object, and handle is the verified submission-token handle (binds the nonce to the submitter, preventing cross-account replay). On ingestion public-dj RECOMPUTES digest+signature from the SUBMITTED episode + its own server_key + the token handle, treats the proxy-log scores as authoritative (overwriting submitted episode scores), and HOLDS the episode (verified=false) on any of: signature mismatch, digest != submitted episode, handle mismatch, expired/unknown request_id, or request_id not in the proxy log for this token.",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "signature", "digest", "issued_at"],
      "properties": {
        "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$" },
        "signature": {
          "description": "Base64url HMAC-SHA256 over the frozen preimage (see scoringNonce.description).",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32,128}$"
        },
        "digest": {
          "description": "Base64url-unpadded SHA-256 (exactly 43 chars) of JCS({episode_id, type, scores}). public-dj recomputes from the submitted episode and compares.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    },
    "sessionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_ref", "message_count"],
      "properties": {
        "session_ref": { "$ref": "#/$defs/opaqueRef" },
        "agent_type": { "enum": ["claude", "codex", "cursor"] },
        "message_count": { "type": "integer", "minimum": 0 },
        "first_prompt": {
          "description": "Scrubbed first user prompt, bounded. Passes both redaction layers.",
          "type": "string",
          "maxLength": 200
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "is_subagent": { "type": "boolean" },
        "session_intent": {
          "enum": ["feature", "bugfix", "refactor", "investigation", "infra", "review", "planning", "other"]
        },
        "active_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "type", "proposal", "response"],
      "properties": {
        "decision_id": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "type": {
          "enum": ["architecture", "tradeoff", "course_correction", "scope", "tooling", "other"]
        },
        "proposal": {
          "description": "Paraphrased, scrubbed description of what was proposed. Never raw transcript/code.",
          "type": "string",
          "maxLength": 400
        },
        "response": {
          "description": "Paraphrased, scrubbed description of the human's decision/response.",
          "type": "string",
          "maxLength": 400
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "significance": { "enum": ["low", "medium", "high"] },
        "reversibility": { "enum": ["reversible", "costly", "irreversible"] },
        "outcome": { "enum": ["accepted", "rejected", "modified", "deferred", "unknown"] },
        "episode_id": { "$ref": "#/$defs/episodeId" },
        "initiative": {
          "description": "Who raised the concern/direction first (rubric 1.1 initiative attribution).",
          "type": "object",
          "additionalProperties": false,
          "required": ["raised_by"],
          "properties": {
            "raised_by": { "enum": ["human", "agent", "unknown"] }
          }
        },
        "outcome_evidence": {
          "description": "Deterministic outcome linkage (rubric 1.1): what actually happened after the decision.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit_within_2h": { "type": "boolean" },
            "test_signal_after": { "enum": ["pass", "fail", "none"] },
            "reversed_later": { "type": "boolean" }
          }
        },
        "topics": {
          "description": "Fixed topic taxonomy tags feeding specialty_signals.",
          "type": "array",
          "maxItems": 3,
          "items": {
            "enum": ["scalability", "security", "data_modeling", "distributed_systems", "performance", "ux", "tooling"]
          }
        }
      }
    },
    "episodeId": {
      "description": "Stable opaque episode id: a locally-generated hex digest (e.g. truncated salted SHA-256). Hex-only (0-9a-f) so it cannot encode a path, code identifier, email, or repo/org name.",
      "type": "string",
      "pattern": "^[a-f0-9]{16,64}$"
    },
    "opaqueRef": {
      "description": "Opaque, locally-salted reference: a hex digest (e.g. truncated HMAC of the real id). Hex-only so it cannot encode a session id, path, filename, identifier, or repo/org name.",
      "type": "string",
      "pattern": "^[a-f0-9]{16,64}$"
    },
    "score0to100": { "type": "integer", "minimum": 0, "maximum": 100 },
    "share01": { "type": "number", "minimum": 0, "maximum": 1 },
    "hourHistogram24": {
      "description": "24 LOCAL-clock hour bins (00..23). Derived from per-record offsets; no timezone identifier ever ships.",
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "type": "integer", "minimum": 0 }
    },
    "weekdayHistogram7": {
      "description": "7 LOCAL-clock weekday bins (Sunday=0 .. Saturday=6).",
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "integer", "minimum": 0 }
    },
    "perToolShare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": { "$ref": "#/$defs/share01" },
        "codex": { "$ref": "#/$defs/share01" },
        "cursor": { "$ref": "#/$defs/share01" }
      }
    },
    "perToolCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": { "type": "integer", "minimum": 0 },
        "codex": { "type": "integer", "minimum": 0 },
        "cursor": { "type": "integer", "minimum": 0 }
      }
    },
    "specialtyScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "confidence", "episode_count"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "episode_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
