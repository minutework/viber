#!/bin/bash
set -euo pipefail

# viber-refresh — keep the builder profile a LIVING profile.
#
# Anacron-style daily runner: meant to be fired by a scheduler at ~12:15 AM
# LOCAL time AND at login/boot. A date stamp guarantees at-most-once-per-day
# semantics, so the boot-time firing transparently catches up days the machine
# was powered off at midnight (launchd already coalesces missed firings across
# sleep). The actual analysis is the standard upload.sh pipeline; the Wave-1
# digest caches make repeat runs cheap (only new sessions cost LLM work).
#
# Config: ~/.viber/refresh/config (shell syntax, sourced). Keys:
#   VIBER_REFRESH_PROJECT_PATH   (required) project dir to analyze
#   VIBER_TOKEN_COMMAND          command printing a fresh submission token;
#                                unset => PREPARE-ONLY (dry-run) + notification
#   VIBER_AGENT                  claude|codex|cursor (else upload.sh auto-picks)
#   VIBER_PUBLIC_DJ_BASE_URL / VIBER_PLATFORM_BASE_URL / VIBER_SKILL_URL
#                                endpoint overrides (self-hosted setups)
#   VIBER_REFRESH_DISABLED=1     temporary off-switch without uninstalling
#
# Flags: --force (ignore today's stamp) --status --dry-run (force prepare-only)

VIBER_HOME="${VIBER_HOME:-$HOME/.viber}"
REFRESH_DIR="$VIBER_HOME/refresh"
CONFIG_FILE="$REFRESH_DIR/config"
STAMP_FILE="$REFRESH_DIR/last-success-date"
LOCK_DIR="$REFRESH_DIR/lock"
LOG_DIR="$VIBER_HOME/logs"
LOG_FILE="$LOG_DIR/refresh.log"
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

mkdir -p "$REFRESH_DIR" "$LOG_DIR"
chmod 700 "$VIBER_HOME" "$REFRESH_DIR" 2>/dev/null || true

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"; }

notify() {
  # Best-effort desktop notification (macOS); silent elsewhere.
  command -v osascript >/dev/null 2>&1 &&
    osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
}

FORCE=0
DRY_RUN_FLAG=0
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=1 ;;
    --dry-run) DRY_RUN_FLAG=1 ;;
    --status)
      echo "stamp:  $(cat "$STAMP_FILE" 2>/dev/null || echo never)"
      echo "config: $CONFIG_FILE $([ -f "$CONFIG_FILE" ] && echo present || echo MISSING)"
      echo "log:    $LOG_FILE"
      exit 0
      ;;
    *) echo "viber-refresh: unknown flag '$arg' (--force|--dry-run|--status)" >&2; exit 2 ;;
  esac
done

# shellcheck disable=SC1090
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

if [ "${VIBER_REFRESH_DISABLED:-0}" = "1" ]; then
  log "skipped: VIBER_REFRESH_DISABLED=1"
  exit 0
fi

TODAY="$(date +%F)" # LOCAL date — this is what makes it the user's midnight.
if [ "$FORCE" -eq 0 ] && [ "$(cat "$STAMP_FILE" 2>/dev/null || true)" = "$TODAY" ]; then
  exit 0 # already refreshed today; catch-up firings are silent no-ops
fi

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  # A run older than 6h is a crashed run; reclaim the lock.
  if [ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +360 2>/dev/null)" ]; then
    rm -rf "$LOCK_DIR" && mkdir "$LOCK_DIR"
  else
    log "skipped: another refresh is running"
    exit 0
  fi
fi
trap 'rm -rf "$LOCK_DIR"' EXIT

# Rotate the log at ~1MB.
if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE")" -gt 1048576 ]; then
  mv "$LOG_FILE" "$LOG_FILE.1"
fi

PROJECT_PATH="${VIBER_REFRESH_PROJECT_PATH:-}"
if [ -z "$PROJECT_PATH" ] || [ ! -d "$PROJECT_PATH" ]; then
  log "ERROR: VIBER_REFRESH_PROJECT_PATH is not set to an existing directory (edit $CONFIG_FILE)"
  notify "viber" "Daily profile refresh is not configured — edit ~/.viber/refresh/config"
  exit 1
fi

UPLOAD_ARGS=()
[ -n "${VIBER_AGENT:-}" ] && UPLOAD_ARGS+=(--agent "$VIBER_AGENT")
MODE="live"
if [ "$DRY_RUN_FLAG" -eq 1 ] || { [ -z "${VIBER_TOKEN_COMMAND:-}" ] && [ -z "${VIBER_SUBMIT_TOKEN:-}" ]; }; then
  # No non-interactive token source: prepare-only. The analysis still runs and
  # warms every cache, the payload is validated, nothing is sent.
  UPLOAD_ARGS+=(--dry-run)
  MODE="prepare-only"
fi

log "starting refresh (mode=$MODE, project=$PROJECT_PATH)"
START_TS=$(date +%s)

# Simulation hook for tests/installers: skip the real pipeline.
if [ -n "${VIBER_REFRESH_SIMULATE:-}" ]; then
  log "simulated run (VIBER_REFRESH_SIMULATE set)"
  RESULT=0
else
  set +e
  (cd "$PROJECT_PATH" && bash "$REPO_DIR/upload.sh" "${UPLOAD_ARGS[@]}") >>"$LOG_FILE" 2>&1
  RESULT=$?
  set -e
fi

ELAPSED=$(($(date +%s) - START_TS))
if [ "$RESULT" -eq 0 ]; then
  printf '%s' "$TODAY" >"$STAMP_FILE"
  log "refresh succeeded in ${ELAPSED}s (mode=$MODE)"
  if [ "$MODE" = "live" ]; then
    notify "viber" "Builder profile refreshed — your live profile is up to date."
  else
    notify "viber" "Profile analysis refreshed (prepare-only). Configure VIBER_TOKEN_COMMAND to auto-publish."
  fi
else
  log "refresh FAILED in ${ELAPSED}s (exit $RESULT, mode=$MODE) — will retry at the next firing"
  notify "viber" "Daily profile refresh failed — see ~/.viber/logs/refresh.log"
  exit "$RESULT"
fi
